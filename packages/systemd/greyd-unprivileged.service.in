# greyd-unprivileged.service - generated from
# packages/systemd/greyd-unprivileged.service.in by make.
#
# An alternative to greyd.service that never runs as root: systemd binds
# the SMTP and configuration sockets (greyd.socket, greyd-config.socket)
# and starts greyd as the greyd user with only the capabilities the
# netfilter driver needs (CAP_NET_ADMIN for ipset and conntrack). greyd
# detects the activated sockets, skips the chroot (Landlock confines the
# filesystem instead) and keeps running as the service user; the
# greylister therefore also runs as "greyd", so the database directory
# must be owned by that user rather than by "greydb".
#
#   systemctl disable --now greyd.service
#   systemctl enable --now greyd.socket greyd-config.socket
#
# The pidfile is kept under the runtime directory.

[Unit]
Description=greyd greylisting and blacklisting daemon (socket activated, unprivileged)
Documentation=man:greyd(8) man:greyd.conf(5)
Requires=greyd.socket greyd-config.socket
After=network-online.target greyd.socket greyd-config.socket
Conflicts=greyd.service

[Service]
Type=simple
ExecStart=@sbindir@/greyd -F -f @DEFAULT_CONFIG@ -P /run/greyd/greyd.pid
Restart=on-failure
RestartSec=5
User=greyd
Group=greyd
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
RuntimeDirectory=greyd
RuntimeDirectoryPreserve=yes
StateDirectory=@PACKAGE@

ProtectSystem=strict
ReadWritePaths=-@localstatedir@/@PACKAGE@ -@localstatedir@/log -/var/log
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
