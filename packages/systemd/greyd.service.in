# greyd.service - generated from packages/systemd/greyd.service.in by make.
#
# The unit starts greyd as root on purpose. greyd has to bind the SMTP
# port it greylists on (8025 by default) and its config/sync ports, program
# the firewall (ipset over netlink for the netfilter driver), chroot into
# chroot_dir and only then does it drop to the unprivileged "greyd" and
# "greydb" users itself - controlled by the greyd.conf option "drop_privs"
# (on by default, see greyd.conf(5)). Do not set User= to anything else;
# the capability bounding set below is the superset needed for those
# steps and everything outside it is removed before the process starts.
#
# -F keeps greyd in the foreground so systemd supervises it directly.

[Unit]
Description=greyd greylisting and blacklisting daemon
Documentation=man:greyd(8) man:greyd.conf(5)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@sbindir@/greyd -F -f @DEFAULT_CONFIG@
Restart=on-failure
RestartSec=5
User=root
AmbientCapabilities=
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_SYS_CHROOT CAP_CHOWN CAP_DAC_OVERRIDE
NoNewPrivileges=yes

# Filesystem: everything read-only except the state, runtime, pidfile and
# log locations. Paths prefixed with "-" are ignored when they do not exist.
ProtectSystem=strict
RuntimeDirectory=@PACKAGE@
StateDirectory=@PACKAGE@
ReadWritePaths=-@localstatedir@/@PACKAGE@ -@localstatedir@/run/@PACKAGE@ -@GREYD_PIDDIR@ -@localstatedir@/log -/var/log
ProtectHome=yes
PrivateTmp=yes

# Kernel and process hardening.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX: config socket and the privilege separation pipes;
# AF_NETLINK: ipset/conntrack for the netfilter driver.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
